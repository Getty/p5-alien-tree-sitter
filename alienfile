use alienfile;
use Path::Tiny qw( path );
use Alien::Build::Util qw( _mirror );

# Prefer a system libtree-sitter if pkg-config can find one in the 0.20.x
# series. Falls back to building from the vendored tree-sitter v0.20.8
# source under share/.
#
# Why 0.20.x only: 0.20.8 is the last release of the 0.20.x series, which
# still installs tree_sitter/parser.h next to api.h (the entry-point header
# that upstream grammar parser.c files #include). From 0.21.0 on parser.h
# lives in lib/src/ and is not installed, so a system libtree-sitter of
# 0.21 or newer cannot serve grammars that target 0.20.x. The probe
# therefore accepts 0.20.0 through 0.20.99 and nothing newer.

plugin 'PkgConfig' => (
  pkg_name        => 'tree-sitter',
  minimum_version => '0.20',
  max_version     => '0.20.99',
);

share {

  start_url 'file://' . path('share/tree-sitter-0.20.8.tar.gz')->absolute->stringify;

  plugin 'Fetch::Local';
  plugin 'Extract' => 'tar.gz';

  # Populate runtime_prop before Gather writes _alien/alien.json so
  # Alien::Base can read it back at install time. We hook gather_share
  # early (before Alien::Build::Plugin::Core::Gather's prefix rewrite
  # runs and before the alien.json file is dropped).
  meta->before_hook(
    gather_share => sub {
      my ($build) = @_;
      my $stage   = $build->install_prop->{stage};
      my $extract = $build->install_prop->{extract};
      my $prefix  = $build->install_prop->{prefix};

      # Copy include/, src/ and lib/ into the staged install prefix.
      # Alien::Build's gather [] DSL only adds commands to the gather_share
      # hook (which here doesn't run a real build system that populates
      # stage by itself), so we mirror by hand.
      for my $rel (qw( include src )) {
        my $src = path("$extract/$rel");
        my $dst = path("$stage/$rel");
        next unless -d $src;
        $dst->mkpath;
        _mirror($src, $dst);
      }
      my $srclib = path("$extract/lib");
      if (-d $srclib) {
        my $dst = path("$stage/lib");
        $dst->mkpath;
        _mirror($srclib, $dst);
      }

      # Use the staged prefix for cflags/libs so Gather's install→runtime
      # prefix rewrite (line 91-95 of Core/Gather.pm) actually applies.
      $build->runtime_prop->{cflags}        = "-I$prefix/include";
      $build->runtime_prop->{cflags_static} = "-I$prefix/include";
      $build->runtime_prop->{libs}          = "-L$prefix/lib -ltree-sitter";
      $build->runtime_prop->{libs_static}   = "$prefix/lib/libtree-sitter.a";
      $build->runtime_prop->{version}       = '0.20.8';
    }
  );

  # The tree-sitter library is built from a single translation unit:
  # share/tree-sitter/src/lib.c, which #include-s every other .c in src/.
  # We compile it directly into a static archive libtree-sitter.a so it
  # can be linked straight into Text::Treesitter's XS .so. Grammar .so
  # files (e.g. tree-sitter-bash.so) dlopen these symbols at runtime
  # from the already-loaded Text::Treesitter .so.
  build [
    'cc -O2 -fPIC -std=c99 '
      . '-I%{.install.extract}/include '
      . '-I%{.install.extract}/src '
      . '-c %{.install.extract}/src/lib.c '
      . '-o libtree-sitter.o',

    'mkdir -p lib',
    'ar rcs lib/libtree-sitter.a libtree-sitter.o',

    # Like upstream's `make install`, ship a tree-sitter.pc with the vendored
    # version and the final install prefix (runtime_prop; the install_prop
    # prefix of this build is the stage). The PkgConfig plugin's own
    # gather_share hook runs inside the stage and Core::Gather puts
    # <stage>/lib/pkgconfig on PKG_CONFIG_PATH, but only if that directory
    # already exists when the hook starts - so the .pc is written here, during
    # the build, and not in the gather hook. The plugin then describes the
    # vendored build and not a libtree-sitter that happens to be installed on
    # the host.
    sub {
      my ($build) = @_;
      my $prefix = $build->runtime_prop->{prefix};
      my $pcdir  = path($build->install_prop->{stage}, 'lib', 'pkgconfig');
      $pcdir->mkpath;
      $pcdir->child('tree-sitter.pc')->spew(<<"PC");
prefix=$prefix
includedir=\${prefix}/include
libdir=\${prefix}/lib

Name: tree-sitter
Description: An incremental parsing system for programming tools
URL: https://tree-sitter.github.io/
Version: 0.20.8
Libs: -L\${libdir} -ltree-sitter
Cflags: -I\${includedir}
PC
    },
  ];

  gather [
    [ '%{.install.extract}/include' => '$(INSTALL_PREFIX)/include' ],
    [ '%{.install.extract}/src'     => '$(INSTALL_PREFIX)/src'     ],
    [ 'lib'                         => '$(INSTALL_PREFIX)/lib'     ],
  ];

  # After the build, advertise include + lib paths to consumers via the
  # standard Alien::Base props.
  meta->prop->{cflags}  = '-I%{.install.extract}/include';
  meta->prop->{libs}    = '-L%{.install.stage}/lib -ltree-sitter';
  meta->prop->{version} = '0.20.8';
};

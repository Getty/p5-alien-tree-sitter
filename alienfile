use alienfile;
use Path::Tiny;

# Prefer a system libtree-sitter if pkg-config can find one.
# Falls back to building from the vendored tree-sitter v0.20.8 source
# under share/tree-sitter/.
#
# Why 0.20.8: it is the last release of the 0.20.x series, which still
# ships tree_sitter/parser.h (the canonical entry-point header that
# upstream grammar parser.c files #include). 0.22 removed parser.h and
# unified everything into tree_sitter/api.h, breaking ABI compatibility
# with grammars that target 0.20.x.

plugin 'PkgConfig' => (
  pkg_name        => 'tree-sitter',
  minimum_version => '0.20',
);

share {

  start_url Path::Tiny->cwd->stringify;

  # The tree-sitter library is built from a single translation unit:
  # share/tree-sitter/src/lib.c, which #include-s every other .c in src/.
  # We compile it directly into a static archive libtree-sitter.a so it
  # can be linked straight into Text::Treesitter's XS .so. Grammar .so
  # files (e.g. tree-sitter-bash.so) dlopen these symbols at runtime
  # from the already-loaded Text::Treesitter .so.
  build [
    '%c -O2 -fPIC -std=c99 '
      . '-Ishare/tree-sitter/include '
      . '-Ishare/tree-sitter/src '
      . '-c share/tree-sitter/src/lib.c '
      . '-o libtree-sitter.o',

    'ar rcs lib/libtree-sitter.a libtree-sitter.o',
  ];

  gather [
    [ 'share/tree-sitter/include' => '$(INSTALL_PREFIX)/include' ],
    [ 'share/tree-sitter/src'     => '$(INSTALL_PREFIX)/src'     ],
    [ 'lib'                       => '$(INSTALL_PREFIX)/lib'     ],
  ];

  # After the build, advertise include + lib paths to consumers via the
  # standard Alien::Base props.
  meta->prop->{cflags}  = '-I' . path('share/tree-sitter/include')->absolute->stringify;
  meta->prop->{libs}    = '-L' . path('lib')->absolute->stringify . ' -ltree-sitter';
  meta->prop->{version} = '0.20.8';
};

sys {
  # Use the system libtree-sitter via pkg-config.
  # (The share{} block above will be used when the probe above fails.)
};